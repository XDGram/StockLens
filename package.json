{
  "name": "stocklens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test tests/scoring/classify.test.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "script": "tsx",
    "script:smoke": "tsx scripts/smoke.ts",
    "script:registry": "tsx scripts/registry-smoke.ts",
    "scan": "tsx scripts/scan.ts",
    "exit-preview": "node --env-file-if-exists=.env.local --import tsx scripts/exit-preview.ts"
  },
  "dependencies": {
    "@jup-ag/api": "^6.0.48",
    "@pythnetwork/hermes-client": "^3.1.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
